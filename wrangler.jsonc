// Despliegue en Cloudflare Workers. src/index.js sólo redirige www al dominio principal;
// el sitio son los archivos estáticos de la raíz (.assetsignore deja fuera lo que no es del sitio).
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "perconsur",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
